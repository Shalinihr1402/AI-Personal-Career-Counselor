# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Optional: enables real AI resume parsing via Google Gemini.
# Get a key at https://aistudio.google.com/app/apikey
# Without this (or while genai.configure is commented out in main.py),
# /api/upload-resume returns mock data.
GEMINI_API_KEY=

# Planned integrations - present but not yet wired into the app.
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=postgresql://user:password@host:5432/dbname
