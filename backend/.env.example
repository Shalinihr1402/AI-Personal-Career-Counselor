# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Optional: enables real AI (resume parsing + career matching) via Groq (free tier).
# Get a free key at https://console.groq.com/keys
# Without this, /api/upload-resume returns mock data.
GROQ_API_KEY=
# Optional: override the model (default: openai/gpt-oss-120b).
GROQ_MODEL=

# Planned integrations - present but not yet wired into the app.
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=postgresql://user:password@host:5432/dbname
